# ============================================================================
# Django Configuration
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================================================
# Database Configuration (Supabase PostgreSQL)
# ============================================================================
# For local development, leave this empty to use SQLite
# For production with Supabase, use format:
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require

# Example Supabase connection string:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-region.sql.supabase.co:5432/postgres?sslmode=require

DATABASE_URL=

# ============================================================================
# API Keys
# ============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# Supabase Configuration (For Real-Time Features - Optional)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
